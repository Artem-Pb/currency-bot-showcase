# =============================================================
# Currency Bot — шаблон переменных окружения
# =============================================================
# Скопируй этот файл в .env и заполни значения:
#   cp .env.example .env
#
# Файл .env добавлен в .gitignore — ключи не попадут в репо.
# Этот файл (.env.example) — только болванка без секретов.
# =============================================================

# ── Telegram ──────────────────────────────────────────────────
# Токен бота. Получить: @BotFather → /newbot или /token
BOT_TOKEN=

# Username бота (без @). Пример: my_currency_bot
BOT_NAME=

# Telegram chatId администратора (твой личный chatId)
# Узнать: написать @userinfobot
BOT_ADMIN=

# ── Timeweb Cloud AI Agent ───────────────────────────────────
# Используется для AI-дайджеста и объяснений сигналов (TIER 1+)
# Получить: timeweb.cloud/my/cloud-ai/agents → создать агента →
# "Интеграции" → блок "OpenAI API"
#   BASE_URL — кнопка "Скопировать OpenAI URL", вставлять КАК ЕСТЬ (уже
#              заканчивается на /v1 — код сам добавляет только /chat/completions)
#   TOKEN    — "Управление" → "Доступ по API" → создать/скопировать ключ
TIMEWEB_AGENT_BASE_URL=
TIMEWEB_AGENT_TOKEN=

# ── Шифрование (TIER 3 — автоторговля) ───────────────────────
# AES-256-GCM мастер-ключ для хранения API-ключей пользователей
# Сгенерировать: openssl rand -base64 32
# ВАЖНО: потеря этого ключа = невозможность расшифровать ключи пользователей
ENCRYPTION_KEY=

# ── Внутренний токен bot <-> mcp-server ───────────────────────
# Общий секрет для GET /internal/portfolio/{chatId} (get_user_portfolio).
# Должен быть ОДИНАКОВЫМ в .env бота и в mcp-server/.env.
# Сгенерировать: openssl rand -hex 32
INTERNAL_MCP_TOKEN=
