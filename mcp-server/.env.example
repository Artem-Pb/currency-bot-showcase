# =============================================================
# mcp-server — шаблон переменных окружения
# =============================================================
# Скопируй в .env и заполни значения:
#   cp .env.example .env
#
# Файл .env добавлен в .gitignore — секрет не попадёт в репо.
# =============================================================

# ── Внутренний токен bot <-> mcp-server ───────────────────────
# Общий секрет для GET /internal/portfolio/{chatId} (get_user_portfolio).
# Должен быть ОДИНАКОВЫМ, что и INTERNAL_MCP_TOKEN в .env бота.
# Сгенерировать: openssl rand -hex 32
INTERNAL_MCP_TOKEN=

# ── Адрес currency-bot (для get_user_portfolio) ──────────────
# По умолчанию http://localhost:8080 — меняй только если бот
# слушает на другом хосте/порту.
CURRENCYBOT_INTERNAL_BASE_URL=
